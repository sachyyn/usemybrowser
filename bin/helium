#!/bin/zsh
# helium: drive your own running Helium browser through one persistent chrome-devtools daemon.
# One daemon = one remote-debugging connection = one "Allow" click per Helium launch.
# Usage: helium <chrome-devtools command> [args]   e.g. helium list_pages | helium take_snapshot 3
#        helium start | status | stop
# Local install (npm --prefix ~/.local/share/helium-cdt chrome-devtools-mcp@1.13.0): fast, works offline/sandboxed.
CDT=("$HOME/.local/share/helium-cdt/node_modules/.bin/chrome-devtools")
[ -x "${CDT[1]}" ] || CDT=(npx -y -p chrome-devtools-mcp@1.13.0 chrome-devtools)
HELIUM_DIR="$HOME/Library/Application Support/net.imput.helium"

start_daemon() {
  "${CDT[@]}" start --autoConnect --userDataDir "$HELIUM_DIR" --categoryExtensions=false --no-usage-statistics --no-performance-crux
}

case "$1" in
  start) start_daemon; exit $? ;;
  status|stop) exec "${CDT[@]}" "$@" ;;
esac

# (Re)start only when no daemon runs or the running one is not attached to Helium (the CLI can
# auto-start a plain daemon on its own). Never restart a healthy daemon: each restart opens a new
# connection and Helium asks the user to Allow again.
STATUS=$("${CDT[@]}" status 2>/dev/null)
if [[ "$STATUS" != *"is running"* || "$STATUS" != *"net.imput.helium"* ]]; then
  start_daemon >/dev/null 2>&1 || { echo "helium: could not start the daemon (sandboxed agent? run it outside the sandbox)" >&2; exit 1; }
fi

# helium check <pageId> "<yes/no question>" [decide options]: screenshot + Gemini Decision in one step.
# The agent gets a probability, never the image. Extra args (e.g. --yes/--no criteria) go to decide.
if [ "$1" = "check" ]; then
  [ $# -ge 3 ] || { echo "usage: helium check <pageId> \"<question>\" [decide options]" >&2; exit 2; }
  mkdir -p "$HOME/.cache/helium"; SHOT="$HOME/.cache/helium/check-$2.jpeg"
  "${CDT[@]}" take_screenshot "$2" --filePath "$SHOT" --format jpeg --quality 70 >/dev/null 2>&1 \
    || { echo "helium: screenshot failed for page $2" >&2; exit 1; }
  ID="$2"; Q="$3"; shift 3
  exec decide -q "$Q" "$@" "@$SHOT"
fi

# helium compact <pageId>: headings + interactive elements only, URLs stripped, labels cut to 80 chars.
if [ "$1" = "compact" ]; then
  [ $# -ge 2 ] || { echo "usage: helium compact <pageId>" >&2; exit 2; }
  mkdir -p "$HOME/.cache/helium"; OUT="$HOME/.cache/helium/snapshot-$2.txt"
  "${CDT[@]}" take_snapshot "$2" > "$OUT" 2>&1 || { tail -3 "$OUT" >&2; exit 1; }
  grep -E '^ *uid=[0-9_]+ (heading|link|button|textbox|searchbox|combobox|checkbox|radio|switch|menuitem|tab|option|row|slider|spinbutton) ' "$OUT" \
    | sed -E 's/^ +//; s/ (url|description|haspopup|level|focusable|readonly)(="[^"]*")?//g; s/^(uid=[0-9_]+ [a-z]+ "[^"]{0,80})[^"]*"/\1"/' \
    | awk '!seen[$0 substr($0, index($0," "))]++' | sed 's/^uid=//' | head -150
  echo "-- first field is the uid; compact view of $(wc -l < "$OUT" | tr -d ' ') lines; full snapshot: $OUT"
  exit 0
fi

# helium text <pageId> [css selector] [max chars]: readable text of one part of the page (default: main
# content, else body), blank runs squeezed, capped (default 4000). Cheapest way to read an article/email.
if [ "$1" = "text" ]; then
  [ $# -ge 2 ] || { echo "usage: helium text <pageId> [css selector] [max chars]" >&2; exit 2; }
  SEL=$(printf %s "$3" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')
  MAX="${4:-4000}"; [[ "$MAX" == <-> ]] || { echo "helium: max chars must be a number" >&2; exit 2; }
  # Matches nested inside another match are dropped so text is not repeated.
  JS="() => { const sel = $SEL;
    const all = sel ? [...document.querySelectorAll(sel)] : [document.querySelector('main, [role=main]') || document.body];
    const top = all.filter(e => !all.some(o => o !== e && o.contains(e)));
    if (!top.length) return 'helium: no element matches ' + sel;
    const t = top.map(e => e.innerText.replace(/[ \\t]+\\n/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim()).filter(Boolean).join('\\n---\\n');
    return t.length > $MAX ? t.slice(0, $MAX) + '\\n-- cut at $MAX of ' + t.length + ' chars' : t; }"
  "${CDT[@]}" evaluate_script --pageId "$2" --waitForStableDom false "$JS" 2>&1 \
    | python3 -c 'import json,re,sys; s=sys.stdin.read(); m=re.search(r"```json\n(.*)\n```", s, re.S); print(json.loads(m.group(1)) if m else s.strip())'
  exit 0
fi

# helium find <pageId> <regex>: snapshot to a file, print only matching lines (cheap for agents).
if [ "$1" = "find" ]; then
  [ $# -ge 3 ] || { echo "usage: helium find <pageId> <regex>" >&2; exit 2; }
  mkdir -p "$HOME/.cache/helium"; OUT="$HOME/.cache/helium/snapshot-$2.txt"
  "${CDT[@]}" take_snapshot "$2" > "$OUT" 2>&1 || { tail -3 "$OUT" >&2; exit 1; }
  N=$(grep -c -i -E -- "$3" "$OUT")
  if [ "$N" -eq 0 ]; then echo "-- no matches. Snapshot starts with:"; head -3 "$OUT" | cut -c1-200; exit 1; fi
  grep -i -E -- "$3" "$OUT" | sed -E 's/^ +//' | cut -c1-300 | head -60
  echo "-- $N matches of $(wc -l < "$OUT" | tr -d ' ') lines; full snapshot: $OUT"
  exit 0
fi

exec "${CDT[@]}" "$@"
